{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "0.3.0",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "permissions": ["storage", "contextMenus", "webRequest", "webRequestBlocking", "http://127.0.0.1/", "http://*/*", "https://*/*"],
  "background": { "scripts": ["background/background.js"] },
  "browser_action": { "default_icon": "icons/icon.svg", "default_title": "__MSG_browserActionTitle__" },
  "commands": {
    "toggle-read": {
      "suggested_key": { "default": "Alt+R" },
      "description": "__MSG_commandToggleDescription__"
    }
  },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_idle" }
  ],
  "options_ui": { "page": "options/options.html", "browser_style": true },
  "web_accessible_resources": ["viewer/viewer.html"],
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "browser_specific_settings": {
    "gecko": {
      "id": "tts-lnx-browser@localhost",
      "strict_min_version": "109.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    }
  }
}
