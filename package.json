    "package": "web-ext build --source-dir dist --artifacts-dir web-ext-artifacts"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.5.0",
    "esbuild": "^0.21.5",
    "jsdom": "^24.1.0",
    "pdfjs-dist": "^6.5.438",
    "vitest": "^2.1.0",
    "web-ext": "^8.3.0"
  }
}
