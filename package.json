{
  "name": "tts-lnx-browser",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Firefox-extensie die webpagina's voorleest met natuurlijke stemmen",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "vitest run",
    "lint": "web-ext lint --source-dir dist",
